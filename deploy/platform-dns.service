[Unit]
Description=DNS 安全过滤平台 - DNS 检测服务
Documentation=https://github.com/Milo799/dns-security-filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnsfilter
Group=dnsfilter
WorkingDirectory=/opt/dns-security-filter/platform
# venv 解释器（安装脚本创建）；加载 platform.yaml 配置
ExecStart=/opt/dns-security-filter/platform/venv/bin/python dns_server.py
Restart=on-failure
RestartSec=5

# ---- 资源上限（部署方案 5.3 节要求）----
# 防止缓存把机器打爆：MemoryMax 留 8G 系统余量（32G 机器设 24G；16G 机器建议 10G）
MemoryMax=24G
# 离线名单内存缓存 + 域名结论缓存 + SQLite + 线程池的 FD 消耗
LimitNOFILE=65536
# DNS 高并发下的内核缓冲（配套 sysctl 见安装脚本）
LimitMEMLOCK=infinity

# ---- 安全加固 ----
NoNewPrivileges=true
# 平台需写 data/（SQLite）与读 venv/，不做 ProtectSystem 只读化
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
