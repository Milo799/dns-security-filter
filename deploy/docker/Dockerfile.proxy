# DNS 代理中间件镜像（Go + miekg/dns，多阶段构建）
# 构建上下文：仓库根目录（docker build -f deploy/docker/Dockerfile.proxy .）
# 产物：纯静态二进制 + 最小 alpine 运行镜像

# ---- 构建阶段 ----
FROM golang:1.21-alpine AS build
WORKDIR /src
COPY proxy/ ./proxy
WORKDIR /src/proxy
# 国内网络可改用代理：go env -w GOPROXY=https://goproxy.cn,direct
RUN go mod download \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/dns-proxy .

# ---- 运行阶段 ----
FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=build /out/dns-proxy /app/dns-proxy
COPY proxy/proxy.example.yaml /app/proxy.example.yaml

EXPOSE 53/udp 53/tcp
ENTRYPOINT ["/app/dns-proxy", "-config", "/app/config.yaml"]
