[Unit]
Description=DNS 安全过滤代理中间件（纯转发层）
Documentation=https://github.com/Milo799/dns-security-filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 以 root 运行（内网专用设备 + 上联 ACL 边界防护形态）：免去专用用户属主/属组
# 与 53 特权端口 setcap 授权负担；如需切回专用用户见部署手册 FAQ
WorkingDirectory=/opt/dns-security-filter
ExecStart=/opt/dns-security-filter/bin/dns-proxy -config /opt/dns-security-filter/proxy/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# ---- 资源与安全加固（代理轻量，从紧）----
# 静态 Go 二进制无需动态库之外的任何文件权限
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# 10 万终端并发下的 FD 消耗（UDP/TCP 双栈 + 每查询 socket）
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
